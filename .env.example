# Server-side Google Gemini API key. Set this locally and in the hosting provider's secret settings.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Supabase project URL and server-only service role key. Never expose the service role key to the browser.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
